# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres_instituto_digital"

# ── Auth secrets (REQUIRED, min 32 chars — la app NO arranca sin ellos) ───────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-of-32-chars-min"
COOKIE_SECRET="change-me-to-a-long-random-secret-of-32-chars-min"

# ── Auth TTLs (optional — defaults shown) ─────────────────────────────────────
# Única fuente de verdad: los tokens Y el maxAge de las cookies derivan de aquí.
# Ojo: AUTH_ACCESS_TOKEN_TTL_S es también la latencia máxima de una revocación
# de sesión — el middleware no consulta la DB mientras el token sea válido.
# AUTH_ACCESS_TOKEN_TTL_S=300          # access token (JWT): 5 min
# AUTH_REFRESH_TOKEN_TTL_S=604800      # refresh token / sesión: 7 días
# AUTH_REFRESH_GRACE_S=60              # ventana de gracia del refresh idempotente

# ── JWT claims (optional — defaults shown) ────────────────────────────────────
# AUTH_JWT_ISSUER="instituto-digital"
# AUTH_JWT_AUDIENCE="instituto-digital"

# ── Login rate limiting (optional — defaults shown) ───────────────────────────
# AUTH_LOGIN_MAX_PER_EMAIL=5           # intentos por email por ventana
# AUTH_LOGIN_MAX_PER_IP=20             # intentos por IP por ventana
# AUTH_LOGIN_WINDOW_S=60               # tamaño de la ventana en segundos

# ── Sessions (optional — defaults shown) ──────────────────────────────────────
# AUTH_MAX_SESSIONS_PER_USER=5         # cap de sesiones activas por usuario

# ── Estado de seguridad / revocación (optional — defaults shown) ──────────────
# Cuánto se cachea en memoria el epoch de validez. ES la ventana de propagación
# de una revocación entre nodos: subirlo abarata (nada) y retrasa el corte;
# bajarlo a 1 lo acelera a costa de una lectura por segundo y proceso.
# AUTH_SECURITY_STATE_CACHE_TTL_S=5

# ── Storage (almacenamiento de objetos) ──────────────────────────────────────
# Selección de proveedor: "s3" (o compatibles: MinIO/R2/Spaces) | "gcs".
# Si STORAGE_PROVIDER se define, su bloque de variables es OBLIGATORIO (fail-fast
# al boot). Si se omite, la feature de storage queda inactiva.
#
# ⚠ STORAGE_ENDPOINT es la ÚNICA variable de storage cuya ausencia NO falla al
#   arrancar, y es la que más caro se paga olvidar. Sin ella el SDK de AWS cae en
#   su resolución por defecto y habla con s3.<región>.amazonaws.com: la app
#   levanta bien y solo revienta al subir el primer archivo, con un error de AWS
#   que no menciona R2/MinIO por ningún lado.
#
#   Omitirla SOLO si el proveedor es AWS S3 real. Para todo lo demás es
#   obligatoria:
#     MinIO   http://localhost:9000
#     R2      https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (+ REGION="auto")
#     Spaces  https://<región>.digitaloceanspaces.com
#
# ── Ejemplo local con MinIO (docker compose up -d minio) ──────────────────────
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_FORCE_PATH_STYLE="true"        # obligatorio "true" con MinIO/endpoint custom
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_BUCKET_NAME="instituto-digital-storage"
#
# ── Bucket público y CDN (OPCIONAL) ───────────────────────────────────────────
# Separan el prefijo `media/` del resto. Son dos pasos independientes y se
# pueden dar por separado:
#
#   1) Solo STORAGE_PUBLIC_BUCKET_NAME → los archivos públicos viven en su propio
#      bucket y se siguen sirviendo por el proxy /api/storage. Sin dominio
#      todavía. Es seguro y es el paso previo natural: cuando el dominio exista,
#      basta con añadir la variable de abajo y no hay que mover ni un objeto.
#
#   2) + STORAGE_PUBLIC_DOMAIN → se sirven desde el dominio público con caché de
#      navegador y de edge. Requiere el bucket separado (ver abajo).
#
# El dominio EXIGE el bucket, pero no al revés: definir el dominio sin el bucket
# falla al arrancar. Un Custom Domain de R2 se monta sobre el bucket ENTERO, no
# sobre un prefijo, así que un dominio sobre el bucket único publicaría también
# lo privado (`documentos/`) de forma permanente.
#
# Sin ninguna de las dos, TODO va a STORAGE_BUCKET_NAME y se sirve por el proxy:
# es el modo por defecto y el que corre en local.
# STORAGE_PUBLIC_BUCKET_NAME="instituto-digital-public"
# STORAGE_PUBLIC_DOMAIN="https://cdn.tudominio.com"   # absoluta; https:// en producción

# ── CORS (gestor de nube) ─────────────────────────────────────────────────────
# El ZIP de /dashboard/nube se arma en el navegador con fetch directo al bucket:
# configura CORS de solo lectura (GET, HEAD) para el origen de la app en LOS DOS
# buckets. MinIO local ya lo permite. Ver docs/storage/00-sistema-almacenamiento.md §7.3.

# ── AWS S3 real: quitar STORAGE_ENDPOINT y poner STORAGE_FORCE_PATH_STYLE="false"
#
# ── GCS (alternativa): STORAGE_PROVIDER="gcs" + STORAGE_BUCKET_NAME + una fuente
#    de credenciales ────────────────────────────────────────────────────────────
# GCS_CREDENTIALS_BASE64=""            # JSON de service-account en base64 (PaaS)
# GCS_CREDENTIALS_PATH=""              # ruta a service-account.json
# USE_GCS_EMULATOR="true"              # usar fake-gcs-server local
# GCS_EMULATOR_HOST="http://localhost:4443"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Tema (optional — default shown) ───────────────────────────────────────────
# Copia local del último tema activo. Si el proceso arranca con la base caída,
# sirve este tema en vez del tema base. En Docker, montar un volumen en esta ruta
# para que la copia sobreviva también a un redeploy.
# THEME_SNAPSHOT_PATH=".cache/theme/active-theme.json"

# ── Correo (PRD-08) ───────────────────────────────────────────────────────────
# Sin SMTP_HOST los avisos se encolan igual y solo se escriben en el log.
# En desarrollo: `docker compose up mailpit` y abrir http://localhost:8025
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_SECURE=false                    # true para el puerto 465
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Instituto Digital de Capacitación <no-responder@instituto.gob.mx>"
# APP_BASE_URL="http://localhost:5173" # origen de los enlaces, sin barra final
# EMAIL_WORKER_ENABLED=true            # por defecto: sí, salvo en pruebas
# EMAIL_WORKER_INTERVAL_S=15
