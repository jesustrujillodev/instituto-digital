// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "org", "public"]
}

model User {
  id         Int     @id @default(autoincrement())
  documentId String  @unique @default(uuid()) @db.Uuid
  email      String  @unique
  firstName  String?
  lastName   String?
  password   String?
  role       String  @default("USER")
  phone      String?

  /// Interno (personal del Ayuntamiento) o externo. El externo llega en PRD-02
  /// con el capacitador externo; el enum se crea ya para no migrar dos veces.
  type UserType @default(INTERNAL)

  /// Obligatorio y único para internos. En Postgres un @unique admite varios
  /// NULL, que es exactamente "si se captura, no se repite". La obligatoriedad
  /// para internos la impone el CHECK users_type_coherence, no Prisma.
  employeeNumber String? @unique @map("employee_number")

  jobTitle String? @map("job_title")

  /// Restrict, no SetNull: desactivar una dependencia con personal es la vía
  /// prevista; borrarla y dejar huérfanos, no.
  dependencyId Int?        @map("dependency_id")
  dependency   Dependency? @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  // Referencia estable del proxy de storage (/api/storage?key=...), NO la URL
  // del proveedor — así cambiar S3↔GCS no invalida lo persistido.
  photoUrl   String?
  // Soft-delete: null = activo. Se guarda el instante (y no un booleano) para
  // poder responder "cuándo se archivó" sin una tabla de auditoría.
  archivedAt DateTime? @map("archived_at")

  /// Epoch de validez POR USUARIO: se rechaza todo access token suyo con `iat`
  /// anterior a este instante. null = nunca se revocó nada de esta cuenta.
  ///
  /// Columna propiedad del módulo `auth` — el módulo `users` la ignora y no la
  /// proyecta en SafeUser. El índice sirve a la única consulta que la lee: los
  /// epochs más recientes que el TTL del access token (ver
  /// docs/auth/02-revocacion-inmediata-epoch.md).
  tokensValidAfter DateTime? @map("tokens_valid_after")

  /// Preferencia de esquema de color: "light" | "dark" | "system".
  /// null = nunca eligió; la resolución cae a la cookie o a "system".
  ///
  /// La COOKIE tiene precedencia sobre esta columna: es lo único disponible para
  /// peticiones anónimas, así que serviría dos temas distintos a la misma persona
  /// antes y después de entrar. Esta columna existe para que la preferencia siga
  /// al usuario a un dispositivo nuevo (docs/theme/00-modo-oscuro.md).
  ///
  /// Columna propiedad del módulo `theme` — el módulo `users` la ignora y no la
  /// proyecta en SafeUser, igual que hace con `tokensValidAfter`.
  themeMode String? @map("theme_mode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  trainerProfile     TrainerProfile?
  groupMemberships   GroupMember[]
  coursesCreated     Course[]           @relation("CourseCreator")
  coursesTaught      CourseTrainer[]
  enrollments        Enrollment[]       @relation("EnrollmentParticipant")
  enrollmentsActed   Enrollment[]       @relation("EnrollmentActor")
  resultsRecorded    Enrollment[]       @relation("EnrollmentResultRecorder")
  attendance         CourseAttendance[] @relation("AttendanceParticipant")
  lessonProgress     LessonProgress[]   @relation("LessonProgressParticipant")
  quizAttempts       QuizAttempt[]      @relation("QuizAttemptParticipant")
  quizRetakesGranted QuizAttempt[]      @relation("QuizRetakeGranter")
  attendanceTaken    CourseAttendance[] @relation("AttendanceRecorder")
  evaluationsCreated CourseEvaluation[] @relation("EvaluationCreator")
  evaluationResults  EvaluationResult[] @relation("EvaluationParticipant")
  evaluationsGraded  EvaluationResult[] @relation("EvaluationRecorder")
  credits            Credit[]           @relation("CreditHolder")
  certificates       CertificateIssue[] @relation("CertificateHolder")
  creditsGranted     Credit[]           @relation("CreditGranter")
  creditsRevoked     Credit[]           @relation("CreditRevoker")
  courseRatings      CourseRating[]
  annualPlans        AnnualPlan[]
  planLines          PlanLine[]         @relation("PlanLineCreator")
  planLinesCancelled PlanLine[]         @relation("PlanLineCanceller")

  // documentId y email son @unique — el índice lo crea la constraint;
  // no declarar @@index duplicados.
  @@index([tokensValidAfter])
  @@index([dependencyId, archivedAt])
  @@map("users")
  @@schema("auth")
}

/// Un tema de la biblioteca: la marca de la plataforma, no la preferencia de
/// nadie. El modo claro/oscuro es del usuario y vive en `User.themeMode`.
///
/// Dos juegos de tokens con papeles distintos: `draftTokens` es lo que el
/// builder edita y `publishedTokens` lo que la app sirve. Separarlos es lo que
/// permite iterar un tema sin tocar lo que ven los usuarios.
model Theme {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid
  name       String

  /// Preset de fábrica: se clona, nunca se edita ni se borra. La invariante la
  /// impone theme.rules.ts, no solo la UI.
  isPreset Boolean @default(false) @map("is_preset")

  /// Tokens en edición. SIEMPRE presente: un tema recién creado ya tiene
  /// borrador. El contenido NO se confía: theme.mapper.ts lo valida al leer y
  /// cae al tema base si la fila está corrupta o quedó de un esquema anterior.
  draftTokens Json @map("draft_tokens")

  /// Tokens que sirve la app. null = nunca se publicó este tema, y por tanto no
  /// se puede activar.
  publishedTokens Json?     @map("published_tokens")
  publishedAt     DateTime? @map("published_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appearanceState AppearanceState[]

  @@map("themes")
  @@schema("public")
}

/// Fila única (id = 1), mismo patrón que SecurityState. Aquí colgarán después
/// logo, favicon y nombre de plataforma.
///
/// "Un solo tema activo" queda garantizado POR CONSTRUCCIÓN —una fila, una FK—
/// en vez de por un índice único parcial sobre `themes`, que Prisma no expresa
/// de forma nativa y obligaría a SQL crudo dentro de la migración.
model AppearanceState {
  id            Int      @id @default(1)
  activeThemeId Int?     @map("active_theme_id")
  /// `SetNull` para que borrar el tema activo no rompa la app. Aun así
  /// `theme.rules.ts` lo prohíbe antes de llegar aquí: la FK es la red, no la
  /// regla.
  activeTheme   Theme?   @relation(fields: [activeThemeId], references: [id], onDelete: SetNull)
  updatedAt     DateTime @updatedAt

  @@map("appearance_state")
  @@schema("public")
}

/// Fila única (id = 1). Se lee constantemente y se escribe casi nunca.
/// Todas las escrituras son upsert con where: { id: 1 }.
///
/// Las columnas de lockdown existen ya aunque hoy queden inertes (nullable):
/// la Fase B las activa sin un segundo cambio de esquema.
model SecurityState {
  id Int @id @default(1)

  /// Epoch GLOBAL: se rechaza todo access token con `iat` anterior a este
  /// instante. Lo escribe siempre `now()` de Postgres, nunca el reloj del
  /// proceso — ver docs/auth/01-lockdown-revocacion-inmediata.md §7.3.
  tokensValidAfter DateTime @default(now()) @map("tokens_valid_after")

  lockdownAt     DateTime? @map("lockdown_at")
  lockdownScope  String?   @map("lockdown_scope") // "all" | "except-admin"
  lockdownReason String?   @map("lockdown_reason") // interno — NUNCA al cliente
  lockdownBy     Int?      @map("lockdown_by") // auditoría

  updatedAt DateTime @updatedAt

  @@map("security_state")
  @@schema("auth")
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId Int // el usuario se resuelve por la relación — sin denormalizar documentId

  // Solo se persiste el HASH (SHA-256 hex) del refresh token — el token crudo
  // vive únicamente en la cookie del cliente. Un volcado de esta tabla no
  // permite fabricar sesiones.
  refreshTokenHash String @unique

  // Rotación con ventana de gracia: hash del token anterior + momento de la
  // rotación. Permite tolerar respuestas perdidas en red y detectar reuso
  // malicioso (docs/auth/00-sistema-autenticacion.md §6.2).
  prevTokenHash String?
  rotatedAt     DateTime?

  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prevTokenHash])
  @@map("sessions")
  @@schema("auth")
}

// ──────────────────────────────────────────────────────────────────────────────
// ORG — estructura organizativa del instituto
//
// La dependencia es lo que separa la operación: un titular solo ve y administra
// a su gente. El alcance se resuelve en la aplicación a partir de
// `User.dependencyId`, y las dos invariantes que la aplicación NO puede
// garantizar por sí sola — un solo titular por dependencia y la coherencia
// interno/externo — las impone la base con un índice único parcial y un CHECK,
// ambos escritos a mano en la migración porque Prisma no los expresa.
// ──────────────────────────────────────────────────────────────────────────────

/// Interno = personal del Ayuntamiento, con número de empleado y dependencia.
/// Externo = llega en PRD-02 con el capacitador externo.
enum UserType {
  INTERNAL
  EXTERNAL

  @@schema("auth")
}

/// Unidad organizativa que separa la operación de la plataforma.
model Dependency {
  id         Int       @id @default(autoincrement())
  documentId String    @unique @default(uuid()) @db.Uuid
  name       String    @unique
  acronym    String?
  /// Soft delete, misma semántica que User.archivedAt: null = activa.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users          User[]
  groups         Group[]
  courses        Course[]
  courseAudience CourseDependencyAudience[]
  enrollments    Enrollment[]
  credits        Credit[]
  annualPlans    AnnualPlan[]

  @@map("dependencies")
  @@schema("org")
}

/// Historial de cambios de adscripción. Sin aprobaciones ni estados: es
/// bitácora.
///
/// Las columnas son escalares sin `@relation` a propósito: declararlas obligaría
/// a cuatro relaciones inversas en `User` y `Dependency` para una tabla que solo
/// se lee en bloque, y además permite que una fila sobreviva al borrado
/// permanente de la cuenta que describe — que es justo lo que se espera de una
/// bitácora.
model DependencyChange {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  fromDependencyId Int?     @map("from_dependency_id")
  toDependencyId   Int      @map("to_dependency_id")
  /// Quién lo hizo: el propio usuario o un administrador.
  changedById      Int      @map("changed_by_id")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@map("dependency_changes")
  @@schema("org")
}

model TrainerProfile {
  userId Int  @id @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty   String
  institution String?
  bio         String?

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([archivedAt])
  @@map("trainer_profiles")
  @@schema("org")
}

model Group {
  id           Int        @id @default(autoincrement())
  documentId   String     @unique @default(uuid()) @db.Uuid
  dependencyId Int        @map("dependency_id")
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  name        String
  description String?

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members        GroupMember[]
  courseAudience CourseGroupAudience[]

  @@index([dependencyId, archivedAt])
  @@map("groups")
  @@schema("org")
}

model GroupMember {
  groupId   Int      @map("group_id")
  userId    Int      @map("user_id")
  addedById Int      @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
  @@schema("org")
}

// ──────────────────────────────────────────────────────────────────────────────
// CURSOS — la unidad que se imparte y se acredita
//
// Todo curso pertenece a una dependencia organizadora. Quién puede verlo depende
// de `access` y de las dos tablas de audiencia; quién puede administrarlo, del
// alcance de course.access.ts. Las horas se guardan en UTC y se capturan y se
// muestran SIEMPRE en la zona del instituto (app/lib/date-utils.ts).
// ──────────────────────────────────────────────────────────────────────────────

enum CourseModality {
  IN_PERSON
  ONLINE
  HYBRID

  @@schema("org")
}

/// Si el curso se reúne o se recorre a ritmo propio (docs/adr/0011). Es un eje
/// distinto de `CourseModality`, que dice dónde se reúne el que sí se reúne.
enum CourseFormat {
  SCHEDULED
  SELF_PACED

  @@schema("org")
}

enum CourseAccess {
  PUBLIC
  RESTRICTED
  INVITATION

  @@schema("org")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED

  @@schema("org")
}

/// Con qué se da por completado el curso (docs/adr/0011). `CONTENT` se apoya hoy
/// en el resultado capturado a mano; gana el avance por lección cuando exista.
enum CourseCompletionRule {
  ATTENDANCE
  CONTENT
  BOTH

  @@schema("org")
}

/// Quién escribió la marca de asistencia: el capacitador a mano o el propio
/// asistente escaneando el QR del curso (§6.8).
enum AttendanceSource {
  MANUAL
  QR

  @@schema("org")
}

/// Un curso. No lleva `archivedAt`: su baja es `status = CANCELLED`, porque §6.5
/// del alcance exige que cancelar conserve los registros. Dos mecanismos de baja
/// sobre la misma fila se contradirían en la primera consulta.
model Course {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  /// La organizadora. El superadministrador la elige; los demás la heredan de su
  /// alcance. Restrict por lo mismo que en User: desactivar una dependencia con
  /// cursos es la vía prevista; borrarla y dejarlos huérfanos, no.
  dependencyId Int        @map("dependency_id")
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  title       String
  description String?

  /// Horas que acredita el curso. Nulo en los cursos anteriores: esos toman la
  /// duración de sus sesiones (`courseHoursOf`).
  hours Int? @map("hours")

  /// Portada del curso. Guarda la REFERENCIA del proxy (`/api/storage?key=…`),
  /// nunca la URL del proveedor: cambiar S3↔GCS o de dominio no invalida la fila.
  /// Su key vive bajo `media/`, que es público y elegible para CDN.
  coverImageUrl String? @map("cover_image_url")

  modality CourseModality
  access   CourseAccess

  /// Formato y regla de completado: dos ejes que `modality` no responde
  /// (docs/adr/0011). El default deja a todo curso anterior exactamente como
  /// estaba: con sesiones y completado por asistencia.
  format         CourseFormat         @default(SCHEDULED)
  completionRule CourseCompletionRule @default(ATTENDANCE) @map("completion_rule")

  /// Opcionales por definición del alcance: un curso puede no tener tope de
  /// plazas ni fecha límite. Sin límite, la inscripción cierra al empezar la
  /// primera sesión (§6.6, `enrollmentClosesAt`).
  capacity           Int?      @map("capacity")
  enrollmentDeadline DateTime? @map("enrollment_deadline")

  /// Porcentaje. El 80 por defecto sale de §6.8 y se ajusta por curso.
  minAttendance      Int              @default(80) @map("min_attendance")
  requiresEvaluation Boolean          @default(false) @map("requires_evaluation")
  /// Con qué se evalúa, si se evalúa: captura manual o examen en línea
  /// (docs/adr/0015). Se congela al publicar.
  evaluationMethod   EvaluationMethod @default(MANUAL) @map("evaluation_method")

  /// Token opaco del QR de asistencia. Nulo mientras nadie lo genere: así la
  /// ficha distingue "sin QR" de "con QR", y una columna única no obliga a un
  /// backfill. Rotarlo invalida el código ya impreso.
  qrToken          String?   @unique @map("qr_token")
  qrTokenRotatedAt DateTime? @map("qr_token_rotated_at")

  /// Minutos de tolerancia de la ventana de escaneo alrededor de cada sesión.
  qrOpensBeforeMinutes Int @default(15) @map("qr_opens_before_minutes")
  qrClosesAfterMinutes Int @default(15) @map("qr_closes_after_minutes")

  status CourseStatus @default(DRAFT)

  createdById Int  @map("created_by_id")
  createdBy   User @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Línea del plan anual que originó el curso. Un curso cancelado conserva el
  /// vínculo: el estado de la línea se deriva del curso que NO está cancelado
  /// (docs/adr/0007).
  planLineId Int?      @map("plan_line_id")
  planLine   PlanLine? @relation(fields: [planLineId], references: [id], onDelete: Restrict)

  publishedAt DateTime? @map("published_at")
  cancelledAt DateTime? @map("cancelled_at")
  finishedAt  DateTime? @map("finished_at")

  /// Interruptor de inscripciones del autogestivo, que no se finaliza nunca:
  /// cerrado, quien ya está inscrito sigue avanzando y nadie nuevo entra
  /// (docs/adr/0014).
  enrollmentClosedAt DateTime? @map("enrollment_closed_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           CourseSession[]
  modules            CourseModule[]
  trainers           CourseTrainer[]
  dependencyAudience CourseDependencyAudience[]
  groupAudience      CourseGroupAudience[]
  enrollments        Enrollment[]
  evaluations        CourseEvaluation[]
  quizzes            Quiz[]
  credits            Credit[]
  ratings            CourseRating[]
  certificate        CourseCertificate?
  certificateIssues  CertificateIssue[]

  @@index([dependencyId, status])
  @@index([createdById])
  @@index([planLineId])
  @@map("courses")
  @@schema("org")
}

/// Diseño del certificado de un curso, con borrador y publicado como `Theme`
/// (docs/adr/0018). Los blobs se validan al leer: una fila de un esquema
/// anterior cae al diseño por defecto en vez de romper la pantalla. La fila
/// nace al primer guardado; sin ella, el curso usa el diseño por defecto.
model CourseCertificate {
  id Int @id @default(autoincrement())

  courseId Int    @unique @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  draftDesign     Json      @map("draft_design")
  /// Null mientras nunca se publique. Es el que usa la emisión (F-09).
  publishedDesign Json?     @map("published_design")
  publishedAt     DateTime? @map("published_at")

  /// Los usa la entrega al participante (F-11); nacen aquí para no migrar después.
  isDownloadable Boolean @default(true) @map("is_downloadable")
  emailMessage   String? @map("email_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("course_certificates")
  @@schema("org")
}

/// Un certificado emitido, uno por persona y curso. Congela el diseño Y los
/// datos al emitir (docs/adr/0019): editar la plantilla o renombrar el curso no
/// cambia un documento ya entregado. Retirarlo marca `revokedAt`; restaurarlo
/// lo limpia y conserva el folio, como `Credit`.
model CertificateIssue {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @map("document_id") @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  userId Int  @map("user_id")
  user   User @relation("CertificateHolder", fields: [userId], references: [id], onDelete: Restrict)

  folio          String   @unique
  issuedAt       DateTime @map("issued_at")
  designSnapshot Json     @map("design_snapshot")
  dataSnapshot   Json     @map("data_snapshot")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, userId])
  @@index([userId])
  @@map("certificate_issues")
  @@schema("org")
}

/// El consecutivo `{seq}` de los folios: global y sin reinicio, para que dos
/// cursos con el mismo formato nunca choquen. Una sola fila.
model CertificateFolioCounter {
  id    String @id
  value Int    @default(0)

  @@map("certificate_folio_counter")
  @@schema("org")
}

/// Fecha y horario concretos de un curso.
///
/// `documentId` no es decorativo: el formulario lo devuelve por cada fila para
/// que editar un curso CONSERVE la identidad de las sesiones que no cambiaron.
/// En PRD-06 cada una cuelga su asistencia, y recrearlas la dejaría huérfana.
model CourseSession {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// Según la modalidad. Se exigen al PUBLICAR, no al guardar: un borrador puede
  /// estar incompleto, que es para lo que sirve.
  venue String?
  link  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance  CourseAttendance[]
  evaluations CourseEvaluation[]

  @@index([courseId, startsAt])
  @@index([startsAt])
  @@map("course_sessions")
  @@schema("org")
}

// ──────────────────────────────────────────────────────────────────────────────
// CONTENIDO — el temario que se recorre a ritmo propio (docs/adr/0012)
//
// Vive aparte del curso porque tiene su propio ciclo de vida y su propio público:
// el participante inscrito lo lee sin tocar nada de la administración del curso.
// ──────────────────────────────────────────────────────────────────────────────

/// Un módulo del temario: el contenedor ordenado de lecciones de un curso.
model CourseModule {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?

  /// Posición dentro del curso, contigua desde 1. Sin `@@unique([courseId, order])`
  /// a propósito: reordenar reescribe varias filas y la restricción chocaría a
  /// mitad de la permutación. La contigüidad la garantiza la regla de dominio,
  /// que escribe el orden completo de una vez y dentro de una transacción.
  order Int

  /// Se archiva, no se borra: el avance por lección colgará de estas filas.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]
  quizzes Quiz[]

  @@index([courseId, order])
  @@map("course_modules")
  @@schema("org")
}

/// Qué clase de material colgará de la lección. Se elige al crearla porque decide
/// el editor que se abre, no solo cómo se pinta.
enum LessonType {
  TEXT
  FILE
  VIDEO
  LINK
  QUIZ

  @@schema("org")
}

/// Una lección: la unidad mínima que alguien recorre y marca como vista.
model Lesson {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  moduleId Int          @map("module_id")
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title String
  type  LessonType

  order Int

  /// Solo las obligatorias entrarán en el porcentaje de avance.
  isRequired       Boolean @default(true) @map("is_required")
  estimatedMinutes Int?    @map("estimated_minutes")

  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content  LessonContent?
  progress LessonProgress[]
  quiz     Quiz?

  @@index([moduleId, order])
  @@map("lessons")
  @@schema("org")
}

/// El material de una lección: uno por lección, de la clase que diga su `type`.
model LessonContent {
  id       Int    @id @default(autoincrement())
  lessonId Int    @unique @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// TEXT: el árbol del documento. No se confía al leer —se valida contra la
  /// lista blanca de nodos y cae al documento vacío si la fila quedó vieja—,
  /// que es lo que permite añadir un bloque nuevo sin migrar.
  body Json?

  /// FILE y VIDEO. `fileUrl` guarda la REFERENCIA DEL PROXY, no la key cruda ni
  /// la URL del proveedor: es lo mismo que `Course.coverImageUrl` y es contra lo
  /// que compara la fuente de referencias de storage.
  fileUrl  String? @map("file_url")
  fileName String? @map("file_name")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")

  /// LINK: el enlace externo, ya validado como http(s).
  externalUrl String? @map("external_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lesson_contents")
  @@schema("org")
}

/// Quién imparte. Al menos uno por curso publicado (§6.5).
model CourseTrainer {
  courseId   Int      @map("course_id")
  userId     Int      @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_trainers")
  @@schema("org")
}

/// Audiencia por dependencia completa. Solo cuando el acceso es RESTRICTED.
///
/// Son dos tablas y no una con dos columnas nullables porque así la base impone
/// sola lo que un CHECK tendría que vigilar: la tabla ES el tipo de audiencia, y
/// la PK compuesta impide repetir. Con una sola tabla, Postgres nunca considera
/// iguales dos NULL, así que un índice único dejaría pasar el mismo grupo dos
/// veces en el mismo curso.
model CourseDependencyAudience {
  courseId     Int @map("course_id")
  dependencyId Int @map("dependency_id")

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dependency Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  @@id([courseId, dependencyId])
  @@index([dependencyId])
  @@map("course_dependency_audience")
  @@schema("org")
}

/// Audiencia por lista nominal. Un grupo acota a unas pocas personas de UNA
/// dependencia, así que no es redundante con la fila de esa dependencia: es más
/// estrecha.
model CourseGroupAudience {
  courseId Int @map("course_id")
  groupId  Int @map("group_id")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([courseId, groupId])
  @@index([groupId])
  @@map("course_group_audience")
  @@schema("org")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inscripción e invitaciones (PRD-04)
// ─────────────────────────────────────────────────────────────────────────────

enum EnrollmentOrigin {
  SELF
  ASSIGNED
  INVITATION

  @@schema("org")
}

enum EnrollmentStatus {
  INVITED
  ENROLLED
  DECLINED
  WITHDRAWN

  @@schema("org")
}

enum EnrollmentResult {
  PENDING
  PASSED
  FAILED

  @@schema("org")
}

/// Una fila por persona y curso: bajas y rechazos cambian el estado, y volver a
/// inscribirse reutiliza la fila (docs/adr/0004).
model Enrollment {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("EnrollmentParticipant", fields: [userId], references: [id], onDelete: Restrict)

  /// La de la persona al inscribirse o aceptar, no la actual.
  dependencyId Int        @map("dependency_id")
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  origin EnrollmentOrigin
  status EnrollmentStatus
  result EnrollmentResult @default(PENDING)

  /// Nota opcional de 0 a 100; solo acompaña a un resultado capturado (§6.8).
  grade     Int?
  /// Lo escribe el cierre del curso y cada corrección posterior (docs/adr/0006).
  completed Boolean @default(false)

  /// Caché del avance por lección: se recalcula, no se confía (docs/adr/0014).
  progressPercent    Int       @default(0) @map("progress_percent")
  /// Se fija una vez y no se borra: añadir una lección obligatoria después no
  /// le quita el completado a quien ya terminó el temario de entonces.
  contentCompletedAt DateTime? @map("content_completed_at")

  resultRecordedById Int?      @map("result_recorded_by_id")
  resultRecordedBy   User?     @relation("EnrollmentResultRecorder", fields: [resultRecordedById], references: [id], onDelete: Restrict)
  resultRecordedAt   DateTime? @map("result_recorded_at")

  actedById Int  @map("acted_by_id")
  actedBy   User @relation("EnrollmentActor", fields: [actedById], references: [id], onDelete: Restrict)

  invitedAt   DateTime? @map("invited_at")
  enrolledAt  DateTime? @map("enrolled_at")
  respondedAt DateTime? @map("responded_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
  @@schema("org")
}

// ─────────────────────────────────────────────────────────────────────────────
// Impartición, créditos y valoración (PRD-06)
// ─────────────────────────────────────────────────────────────────────────────

/// Pase de lista: una fila por sesión y persona. Se reescribe al corregir, y
/// `recordedBy`/`recordedAt` guardan el último cambio (§6.8).
model CourseAttendance {
  sessionId Int           @map("session_id")
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("AttendanceParticipant", fields: [userId], references: [id], onDelete: Restrict)

  attended Boolean

  /// Lo ya registrado antes del QR fue manual, de ahí el default.
  source AttendanceSource @default(MANUAL)

  recordedById Int      @map("recorded_by_id")
  recordedBy   User     @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @map("recorded_at")

  @@id([sessionId, userId])
  @@index([userId])
  @@map("course_attendance")
  @@schema("org")
}

/// Una evaluacion del curso (§6.8). Hay varias por curso y la sesion es
/// opcional: un proyecto final no corresponde a un dia concreto.
model CourseEvaluation {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// `SetNull` y no `Cascade`: borrar una sesion al editar el curso no puede
  /// llevarse por delante evaluaciones ya capturadas.
  sessionId Int?           @map("session_id")
  session   CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  title String

  createdById Int  @map("created_by_id")
  createdBy   User @relation("EvaluationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results EvaluationResult[]

  @@index([courseId])
  @@index([sessionId])
  @@map("course_evaluations")
  @@schema("org")
}

/// Resultado por persona. La fila existe solo si se capturo: su ausencia es
/// "sin capturar", igual que en el pase de lista.
model EvaluationResult {
  evaluationId Int              @map("evaluation_id")
  evaluation   CourseEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("EvaluationParticipant", fields: [userId], references: [id], onDelete: Restrict)

  /// `null` es "sin veredicto todavia": la fila existe porque hay observacion.
  /// Sin capturar de verdad es que no haya fila, igual que en el pase de lista.
  passed Boolean?

  /// Observacion de quien imparte. Interna: ninguna proyeccion del participante
  /// la selecciona.
  note String?

  recordedById Int      @map("recorded_by_id")
  recordedBy   User     @relation("EvaluationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @map("recorded_at")

  @@id([evaluationId, userId])
  @@index([userId])
  @@map("evaluation_results")
  @@schema("org")
}

/// Un crédito por persona y curso. Retirarlo marca `revokedAt` en vez de borrar
/// la fila, y volver a otorgarlo la limpia (docs/adr/0006).
model Credit {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  userId Int  @map("user_id")
  user   User @relation("CreditHolder", fields: [userId], references: [id], onDelete: Restrict)

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// La de la persona al obtenerlo. Si se cambia después, el crédito sigue
  /// contando para esta (§6.9).
  dependencyId Int        @map("dependency_id")
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  /// Ejercicio: año, en la zona del instituto, de la última sesión del curso.
  fiscalYear Int @map("fiscal_year")

  grantedAt   DateTime @map("granted_at")
  grantedById Int      @map("granted_by_id")
  grantedBy   User     @relation("CreditGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  revokedAt   DateTime? @map("revoked_at")
  revokedById Int?      @map("revoked_by_id")
  revokedBy   User?     @relation("CreditRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([dependencyId, fiscalYear])
  @@index([userId, fiscalYear])
  @@index([courseId])
  @@map("credits")
  @@schema("org")
}

/// Valoración de 1 a 5. Única por persona y curso y no se edita (§6.10). El autor
/// se guarda para impedir duplicados; ninguna lectura lo proyecta.
model CourseRating {
  id Int @id @default(autoincrement())

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  score   Int
  comment String?

  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@map("course_ratings")
  @@schema("org")
}

// ─────────────────────────────────────────────────────────────────────────────
// Plan anual (PRD-07)
// ─────────────────────────────────────────────────────────────────────────────

/// Un plan por dependencia y ejercicio. No pasa por aprobaciones (§6.11).
model AnnualPlan {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  dependencyId Int        @map("dependency_id")
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Restrict)

  fiscalYear Int @map("fiscal_year")

  createdById Int  @map("created_by_id")
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PlanLine[]

  @@unique([dependencyId, fiscalYear])
  @@map("annual_plans")
  @@schema("org")
}

/// Un curso previsto. No guarda su estado: pendiente, programada y realizada se
/// derivan del curso vinculado; solo la cancelación manual se persiste.
model PlanLine {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  planId Int        @map("plan_id")
  plan   AnnualPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  title             String
  /// 1 a 12.
  plannedMonth      Int             @map("planned_month")
  plannedModality   CourseModality? @map("planned_modality")
  estimatedDuration String?         @map("estimated_duration")
  targetAudience    String?         @map("target_audience")
  notes             String?

  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById Int?      @map("cancelled_by_id")
  cancelledBy   User?     @relation("PlanLineCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  createdById Int  @map("created_by_id")
  createdBy   User @relation("PlanLineCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@index([planId, plannedMonth])
  @@map("plan_lines")
  @@schema("org")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notificaciones por correo (PRD-08)
// ─────────────────────────────────────────────────────────────────────────────

enum EmailStatus {
  PENDING
  SENT
  FAILED

  @@schema("org")
}

/// Cola de salida del correo. Se escribe en la misma transacción que el caso de
/// uso que avisa y la vacía un worker (docs/adr/0008). No es una bitácora que
/// alguien consulte: los enviados se purgan.
model EmailOutbox {
  id Int @id @default(autoincrement())

  template  String
  /// Copiado al encolar y sin FK: el aviso sale aunque la cuenta cambie después.
  recipient String

  /// Renderizados al encolar, con los datos del momento del evento.
  subject String
  text    String
  html    String

  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  /// Reserva de un worker: otro proceso no toma el mensaje hasta que venza.
  lockedUntil   DateTime?   @map("locked_until")
  lastError     String?     @map("last_error")
  sentAt        DateTime?   @map("sent_at")

  createdAt DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
  @@schema("org")
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED

  @@schema("org")
}

/// Sin fila = sin empezar, igual que `CourseAttendance`: no hay valor centinela.
model LessonProgress {
  lessonId Int    @map("lesson_id")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("LessonProgressParticipant", fields: [userId], references: [id], onDelete: Restrict)

  status      LessonProgressStatus
  startedAt   DateTime             @map("started_at")
  completedAt DateTime?            @map("completed_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@id([lessonId, userId])
  @@index([userId])
  @@map("lesson_progress")
  @@schema("org")
}

enum EvaluationMethod {
  MANUAL
  QUIZ

  @@schema("org")
}

enum QuizQuestionType {
  SINGLE_CHOICE
  TRUE_FALSE

  @@schema("org")
}

/// Un cuestionario autocalificado (docs/adr/0015, 0016). Con `lessonId` es la
/// práctica de una lección `QUIZ`; con `moduleId`, la evaluación de ese módulo;
/// sin ninguno, el examen final del curso. Hay a lo sumo un examen por curso y
/// un cuestionario activo por módulo: no se expresa con índices parciales, lo
/// impone el servicio con la fila del curso bloqueada.
model Quiz {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  courseId Int    @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonId Int?    @unique @map("lesson_id")
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  moduleId Int?          @map("module_id")
  module   CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  /// Solo el de módulo se archiva: sus intentos respaldan completados ya dados.
  archivedAt DateTime? @map("archived_at")

  title            String
  /// Porcentaje de 0 a 100 con el que se aprueba.
  passingScore     Int     @map("passing_score")
  shuffleQuestions Boolean @default(false) @map("shuffle_questions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([moduleId])
  @@map("quizzes")
  @@schema("org")
}

/// Se reescriben enteras al guardar el banco: solo mientras nadie lo presentó.
model QuizQuestion {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  quizId Int  @map("quiz_id")
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  statement String
  type      QuizQuestionType
  points    Int
  order     Int

  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId, order])
  @@map("quiz_questions")
  @@schema("org")
}

model QuizOption {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  questionId Int          @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @map("is_correct")
  order     Int

  answers QuizAnswer[]

  @@index([questionId, order])
  @@map("quiz_options")
  @@schema("org")
}

/// Un intento por persona y cuestionario, salvo que quien imparte habilite otro
/// sobre uno reprobado de módulo (docs/adr/0016). La unicidad por número es la
/// última defensa contra dos envíos simultáneos.
model QuizAttempt {
  id         Int    @id @default(autoincrement())
  documentId String @unique @default(uuid()) @db.Uuid

  quizId Int  @map("quiz_id")
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("QuizAttemptParticipant", fields: [userId], references: [id], onDelete: Restrict)

  number Int @default(1)

  submittedAt DateTime @map("submitted_at")
  /// Porcentaje entero, hacia abajo, sobre los puntos del banco.
  score       Int
  passed      Boolean

  /// Con valor, este intento ya no cierra el cuestionario: hay otro habilitado.
  retakeGrantedAt   DateTime? @map("retake_granted_at")
  retakeGrantedById Int?      @map("retake_granted_by_id")
  retakeGrantedBy   User?     @relation("QuizRetakeGranter", fields: [retakeGrantedById], references: [id], onDelete: Restrict)

  answers QuizAnswer[]

  @@unique([quizId, userId, number])
  @@index([userId])
  @@map("quiz_attempts")
  @@schema("org")
}

model QuizAnswer {
  attemptId Int         @map("attempt_id")
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int          @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionId Int        @map("option_id")
  option   QuizOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  isCorrect Boolean @map("is_correct")

  @@id([attemptId, questionId])
  @@map("quiz_answers")
  @@schema("org")
}
