{
	"name": "instituto-digital",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"lint": "biome check --write .",
		"lint:staged": "lint-staged",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify:commit": "bun run lint:staged && bun run typecheck",
		"verify:push": "bun run test",
		"seed": "bun prisma/seed.ts",
		"lockdown": "bun scripts/lockdown.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1095.0",
		"@aws-sdk/s3-request-presigner": "^3.1095.0",
		"@google-cloud/storage": "^7.21.0",
		"@hookform/resolvers": "^5.5.3",
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"@react-router/node": "7.12.0",
		"@react-router/serve": "7.12.0",
		"awilix": "^12.1.1",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"client-zip": "^2.5.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.3.0",
		"culori": "^4.0.2",
		"dotenv": "^17.4.2",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"exceljs": "^4.4.0",
		"isbot": "^5.2.1",
		"jose": "^6.2.4",
		"lucide-react": "^1.26.0",
		"nodemailer": "^10.0.10",
		"pg": "^8.22.0",
		"prisma": "^7.9.0",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-dropzone": "^20.1.0",
		"react-hook-form": "^7.83.0",
		"react-router": "7.12.0",
		"shadcn": "^4.21.0",
		"sileo": "^0.1.5",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@react-router/dev": "7.12.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^3.0.0",
		"@types/culori": "^4.0.1",
		"@types/node": "^25.9.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.20.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.10"
	}
}
