{
	"name": "instituto-digital",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build && vite build -c vite.worker.config.ts && vite build -c vite.http.config.ts",
		"dev": "react-router dev",
		"start": "node --enable-source-maps build/http/index.js",
		"worker": "bun app/worker.server.ts",
		"start:worker": "node build/worker/index.js",
		"typecheck": "react-router typegen && tsc",
		"lint": "biome check --write .",
		"lint:staged": "lint-staged",
		"lint:arch": "depcruise app scripts prisma --config .dependency-cruiser.cjs --output-type err-long",
		"lint:sql": "bun scripts/check-sql.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify:commit": "bun run lint:staged && bun run lint:arch && bun run lint:sql && bun run typecheck",
		"verify:push": "bun run test",
		"seed": "bun prisma/seed.ts",
		"bootstrap": "bun scripts/bootstrap.ts",
		"lockdown": "bun scripts/lockdown.ts",
		"prepare": "husky",
		"storage:cors": "bun scripts/setup-storage-cors.ts",
		"certificates:samples": "bun scripts/render-certificate-samples.ts",
		"certificates:font-metrics": "bun scripts/generate-font-metrics.ts"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1150.0",
		"@aws-sdk/s3-request-presigner": "^3.1150.0",
		"@cantoo/pdf-lib": "^2.11.1",
		"@google-cloud/storage": "^7.22.0",
		"@hookform/resolvers": "^5.9.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@react-router/express": "7.18.4",
		"@react-router/node": "7.18.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/react": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@vidstack/react": "1.15.6",
		"awilix": "^12.1.1",
		"bcryptjs": "^3.0.3",
		"bullmq": "^5.81.5",
		"class-variance-authority": "^0.7.1",
		"client-zip": "^2.5.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.3.3",
		"compression": "^1.8.2",
		"dotenv": "^17.4.2",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"exceljs": "^4.4.0",
		"express": "^4.22.3",
		"image-size": "^2.0.4",
		"ioredis": "^5.11.1",
		"isbot": "^5.2.2",
		"jose": "^6.2.12",
		"lucide-react": "^1.55.0",
		"nodemailer": "^10.1.0",
		"pg": "^8.23.1",
		"prisma": "^7.10.0",
		"puppeteer-core": "^25.13.0",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.8.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-dropzone": "^20.1.3",
		"react-hook-form": "^7.90.0",
		"react-router": "7.18.4",
		"sileo": "^0.1.5",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@react-router/dev": "7.18.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^3.0.0",
		"@types/compression": "^1.8.1",
		"@types/express": "^4.17.25",
		"@types/fontkit": "^2.0.9",
		"@types/ioredis-mock": "^8.2.8",
		"@types/node": "^25.9.9",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^4.1.11",
		"dependency-cruiser": "^18.6.0",
		"fontkit": "^2.0.4",
		"husky": "^9.1.7",
		"ioredis-mock": "^8.13.1",
		"lint-staged": "^17.6.0",
		"pdfjs-dist": "^6.4.299",
		"pixelmatch": "^7.2.0",
		"shadcn": "^4.21.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.11"
	}
}
