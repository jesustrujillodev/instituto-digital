{
	"include": [
		"**/*",
		"**/.server/**/*",
		"**/.client/**/*",
		".react-router/types/**/*"
	],
	"exclude": ["node_modules", "build", "testsdata", "storage-feature"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./app/*"],
			"@/contexts/*": ["./app/contexts/*"],
			"@/shared/*": ["./app/shared/*"],
			"@/config/*": ["./app/config/*"],
			"@/generated/*": ["./app/generated/*"],
			"@/ui/*": ["./app/shared/components/ui/*"]
		},
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	}
}
